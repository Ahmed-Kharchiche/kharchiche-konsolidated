<?xml version="1.0" encoding="UTF-8"?>
<!-- Independent build: no parent, module or profile is added to the desktop POM. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.kharchiche</groupId><artifactId>konsolidated-mobile</artifactId><version>1.0.0</version>
  <name>Kharchiche Konsolidated</name>
  <properties>
    <!-- The mobile cross compiler is Gluon's Java 17 build, not desktop Java 21. -->
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.11</javafx.version>
    <gluonfx.target>android</gluonfx.target>
    <ios.skipSigning>true</ios.skipSigning>
  </properties>
  <repositories><repository><id>gluon-releases</id><url>https://nexus.gluonhq.com/nexus/content/repositories/releases/</url></repository></repositories>
  <dependencies>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-controls</artifactId><version>${javafx.version}</version></dependency>
    <dependency><groupId>org.openjfx</groupId><artifactId>javafx-fxml</artifactId><version>${javafx.version}</version></dependency>
    <!-- Prepared from the unchanged Xerial 3.46.0.0 JAR; only desktop native-image metadata is removed. -->
    <dependency><groupId>com.kharchiche.mobile</groupId><artifactId>sqlite-jdbc</artifactId><version>3.46.0.0</version>
      <scope>system</scope><systemPath>${project.basedir}/target/dependencies/sqlite-jdbc-mobile.jar</systemPath></dependency>
    <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-nop</artifactId><version>1.7.36</version></dependency>
    <dependency><groupId>com.github.librepdf</groupId><artifactId>openpdf</artifactId><version>1.3.39</version></dependency>
    <dependency><groupId>com.gluonhq.attach</groupId><artifactId>storage</artifactId><version>4.0.21</version></dependency>
    <dependency><groupId>org.graalvm.nativeimage</groupId><artifactId>svm</artifactId><version>22.1.0</version><scope>provided</scope></dependency>
    <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>5.11.4</version><scope>test</scope></dependency>
  </dependencies>
  <build>
    <sourceDirectory>${project.basedir}/target/generated-sources/shared</sourceDirectory>
    <testSourceDirectory>${project.basedir}/target/generated-test-sources</testSourceDirectory>
    <resources>
      <resource><directory>${project.basedir}/../src/main/resources</directory></resource>
      <resource><directory>${project.basedir}/target/generated-resources</directory></resource>
    </resources>
    <plugins>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.13.0</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.3.1</version></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version><configuration><useModulePath>false</useModulePath><reuseForks>false</reuseForks></configuration></plugin>
      <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-jar-plugin</artifactId><version>3.4.2</version></plugin>
      <plugin>
        <groupId>com.gluonhq</groupId><artifactId>gluonfx-maven-plugin</artifactId><version>1.0.23</version>
        <configuration>
          <target>${gluonfx.target}</target><mainClass>MobileMain</mainClass>
          <appIdentifier>com.kharchiche.konsolidated</appIdentifier>
          <javaStaticSdkVersion>18-ea+prep18-9</javaStaticSdkVersion>
          <javafxStaticSdkVersion>21-ea+11.2</javafxStaticSdkVersion>
          <attachVersion>4.0.21</attachVersion><attachList><list>storage</list></attachList>
          <resourcesList><list>view/.*</list><list>images/.*</list><list>com/lowagie/text/pdf/fonts/.*</list></resourcesList>
          <nativeImageArgs>
            <arg>-J-Xmx4g</arg>
            <arg>-H:+ReportExceptionStackTraces</arg>
            <arg>--features=mobile.nativeimage.SQLiteFeature</arg>
            <arg>-H:CLibraryPath=${project.basedir}/target/native</arg>
            <arg>--initialize-at-run-time=org.sqlite,MobileMain,Session</arg>
          </nativeImageArgs>
          <linkerArgs><arg>${project.basedir}/target/native/libsqlitejdbc.a</arg></linkerArgs>
          <releaseConfiguration>
            <appLabel>Kharchiche Konsolidated</appLabel><versionCode>1</versionCode><versionName>${project.version}</versionName>
            <bundleName>Kharchiche Konsolidated</bundleName><bundleVersion>1</bundleVersion><bundleShortVersion>${project.version}</bundleShortVersion>
            <skipSigning>${ios.skipSigning}</skipSigning>
          </releaseConfiguration>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile><id>android</id><properties><gluonfx.target>android</gluonfx.target></properties></profile>
    <profile><id>ios</id><properties><gluonfx.target>ios</gluonfx.target></properties></profile>
    <profile><id>ios-signed</id><properties><ios.skipSigning>false</ios.skipSigning></properties>
      <build><plugins><plugin><groupId>com.gluonhq</groupId><artifactId>gluonfx-maven-plugin</artifactId>
        <configuration><releaseConfiguration>
          <providedSigningIdentity>${env.MOBILE_IOS_SIGNING_IDENTITY}</providedSigningIdentity>
          <providedProvisioningProfile>${env.MOBILE_IOS_PROFILE_NAME}</providedProvisioningProfile>
        </releaseConfiguration></configuration>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
